# ===== Environments =====
.venv/
env/
conda-meta/

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ===== Notebooks =====
.ipynb_checkpoints/

# ===== Model artifacts (regenerable: torch checkpoints, exports) =====
backend/models/
backend/checkpoints/
runs/
outputs/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# ===== FIRMS data =====
backend/data/firms/raw/
backend/data/firms/demo_pack/raw/
backend/data/firms/*.parquet

# ===== HF cache =====
.cache/huggingface/

# ===== Frontend (Vite) =====
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# ===== Env / secrets =====
.env
backend/.env

# ===== Editor / OS =====
.vscode/
.idea/
.DS_Store

# ===== Logs =====
*.log
logs/
.pytest_cache/

# ===== Crash dumps (never commit: GB-sized, regenerable, secret-free junk) =====
core
core.*
vgcore.*

# ===== FIRMS runtime caches (regenerable; evaluation manifests are committed) =====
backend/data/firms/cache/
backend/data/firms/models/backtest_*.json
backend/data/firms/request_ledger.jsonl

# ===== Transformer weights (tiny, required for ?method=ts serving) =====
# The global *.pt rule above is for large checkpoints; these six 400 KB
# state_dicts are part of the reproducible release and are checksummed in
# backend/data/firms/models/TS_WEIGHTS.sha256.
!backend/data/firms/models/ts_*.pt
!backend/data/firms/models/sf_lite*.pt
!backend/data/firms/models/srf_lite*.pt
!backend/data/firms/models/srf*.pt

!backend/data/firms/models/stan*.pt
