# ==========================================================
# Environment configuration - copy to .env and fill in if needed
# These values are actually loaded by prometheus/configs/_settings.py
# ==========================================================

# --- REQUIRED: nothing ---
# The whole pipeline (NTRS + PSI) uses public APIs and needs no key.

# --- OPTIONAL ---
# 1) NASA Open API (api.nasa.gov): for images/APOD/media if wanted.
#    Free registration at https://api.nasa.gov/ (key delivered by email).
#    The pipeline does not use this API, so leaving it blank is fine.
NASA_API_KEY=

# 2) Hugging Face token: only needed for private/gated or large models
#    (Llama, Mistral...). Open models (Qwen, Phi...) need no token.
HF_TOKEN=

# 3) PROMETHEUS core LLM: orchestration/teacher through Ollama.
#    Defaults to gemma4:31b-cloud (Ollama Cloud). Change for another model.
PROMETHEUS_CORE_MODEL=gemma4:31b-cloud
OLLAMA_HOST=http://127.0.0.1:11434
# Seconds to wait for the LLM. The Core model needs ~18 s per answer; the
# old default of 600 meant one hung call held a request thread for 10 minutes.
PROMETHEUS_TIMEOUT=300
# Retries and circuit breaker for the LLM path.
PROMETHEUS_LLM_MAX_ATTEMPTS=2
PROMETHEUS_LLM_RETRY_BACKOFF=1.5
PROMETHEUS_LLM_FAILURES=3
PROMETHEUS_LLM_COOLDOWN=30

# 3b) API keys for a cloud LLM provider (only if not using local Ollama).
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 4) Retrieval / inference defaults (overridable per request).
#    These override the matching values in prometheus.yaml.
PROMETHEUS_TOP_K=8
PROMETHEUS_RERANK_K=4
# Leave blank to use the embedder recorded in the index.
# A measured option: models/prometheus/argus-reranker (head-adapted
# bge-reranker-base; held-out MRR 0.521 -> 0.624 on the same top-20 shortlist,
# see docs/MODEL_CARD.md). It only reorders passages, never invents numbers.
PROMETHEUS_RERANKER=

# 5) CORS. Comma-separated origins that may call the API from a browser.
#    Empty (the default) means same-origin only, which is what the dashboard
#    needs because it is served by this same process. Set this only when the
#    API is hosted on a different origin than the page. "*" allows any site
#    to drive the API from a visitor's browser and spend the LLM quota.
PROMETHEUS_ALLOWED_ORIGINS=

# 5b) Abuse guards for POST /api/prometheus/ask, the only endpoint that spends
#     an LLM call. No user accounts are involved: this is a per-client rate
#     limit plus a global concurrency cap. Set a value to 0 to disable a check.
PROMETHEUS_ASK_RATE_PER_MIN=12
PROMETHEUS_ASK_MAX_CONCURRENCY=2
# The same guard, looser, for the endpoints that run the embedder without
# generating: /api/search/semantic and /api/prometheus/retrieve.
PROMETHEUS_RETRIEVE_RATE_PER_MIN=60
# Optional shared key for a public deployment. Empty = open (default), so a
# local demo never asks for credentials. If set, clients must send X-API-Key.
PROMETHEUS_API_KEY=
# Trust X-Forwarded-For for rate limiting. Turn this on only when a reverse
# proxy really is in front of the app; otherwise any client can rotate the
# header and get a fresh rate-limit budget per request.
PROMETHEUS_TRUST_PROXY=0

# 5c) Demo / reliability. Demo mode answers with quoted passages instead of the
#     LLM, so the page works on a machine without Ollama. The answer cache makes
#     a repeated demo question instant; it is per process and never claimed as a
#     fresh generation (the response says mode="cached").
PROMETHEUS_DEMO_MODE=0
PROMETHEUS_ANSWER_CACHE_TTL=3600
PROMETHEUS_ANSWER_CACHE_ENTRIES=256
# Warm the expensive first-load caches (findings, gap map) in the background.
PROMETHEUS_WARM_CACHE=1
# Maximum request body accepted by the API (bytes).
PROMETHEUS_MAX_BODY_BYTES=1048576

# 6) Frontend (Vite) - base URL of this API.
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- PSI: account for large raw data ---
# PSI raw files >1GB require login and are delivered by email.
# Register: https://psi.nasa.gov/physci/submission-sso-login.html
PSI_USERNAME=
PSI_EMAIL=

# 7) PostgreSQL audit store (optional). The dashboard still works if this is
#    blank or unreachable; only /api/db/health and query auditing are disabled.
#    URL-encode special characters in the password (for example @ -> %40).
#    Create the database/schema with: make db-init
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/alphacentauriab
DB_LOG_QUERIES=1
# How long audited questions are kept. Rows older than this are deleted when
# the server starts, so the audit table cannot grow without bound.
DB_RETENTION_DAYS=30
