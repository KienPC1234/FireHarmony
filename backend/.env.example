# FIRMS Fire Calendar — local settings. Copy to .env and fill in. NEVER commit .env.
# .env is gitignored; only this .example file is tracked.

# Free NASA FIRMS MAP_KEY — get yours at https://firms.modaps.eosdis.nasa.gov/api/area/
# (Map Key section → Get MAP_KEY → email). Needed only for scripts/firms/fetch_firms.py.
FIRMS_MAP_KEY=

# Optional overrides
LOG_LEVEL=INFO
PORT=8000

# Cloudflare Turnstile — protects AI chat + CSV upload/ingest on the public
# funnel. Leave empty to disable (local dev/tests need no captcha).
# Create a widget: dash.cloudflare.com -> Turnstile -> Add widget (Managed),
# hostname = your funnel host. The secret goes only in backend/.env.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
